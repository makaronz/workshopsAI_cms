# Simple WorkshopsAI CMS Configuration
# For small team deployment (max 10 users)

# Server
PORT=3010
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/workshopsai_db
# Update with your actual database credentials

# Frontend URL
CORS_ORIGIN=http://localhost:3000

# Simple API Key for basic security (optional)
API_KEY=your-simple-api-key-here

# OpenAI API (for workshop analysis)
OPENAI_API_KEY=your-openai-api-key-here

# Claude API (for workshop analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# File Upload Settings
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AWS S3 (optional, for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# Google Cloud Storage (optional)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=./service-account-key.json
GOOGLE_CLOUD_BUCKET=your-gcs-bucket

# Simple deployment settings
SERVE_STATIC=true
ENABLE_CACHING=true
CACHE_TTL=300