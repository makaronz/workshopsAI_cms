{
  "name": "workshopsai-cms-simple",
  "version": "1.0.0",
  "description": "Simple CMS for workshopsAI - Small Team Version",
  "main": "src/index-simple.ts",
  "scripts": {
    "dev": "tsx watch src/index-simple.ts",
    "build": "tsc src/index-simple.ts --outDir dist",
    "start": "node dist/index-simple.js",
    "docker:build": "docker build -f Dockerfile.simple -t workshopsai-cms-simple .",
    "docker:run": "docker run -p 3010:3010 --env-file .env.simple workshopsai-cms-simple",
    "setup": "npm install && cp .env.simple .env",
    "validate": "npm run build && echo 'Simple build successful'"
  },
  "keywords": ["CMS", "Workshop", "TypeScript", "Simple", "Small Team"],
  "author": "workshopsAI Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "hpp": "^0.2.3",
    "express-mongo-sanitize": "^2.2.0",
    "xss": "^1.0.14",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "socket.io": "^4.8.1",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.454.0",
    "@sendgrid/mail": "^8.1.6",
    "openai": "^6.9.0",
    "@anthropic-ai/sdk": "^0.69.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.33.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/hpp": "^0.2.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/joi": "^17.2.3",
    "tsx": "^4.6.2",
    "typescript": "^4.9.5"
  }
}