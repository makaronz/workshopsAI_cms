# Railway Environment Configuration
# Copy this file to .env and update values

# ============================================================================
# REQUIRED VARIABLES (Railway provides DATABASE_URL automatically)
# ============================================================================

# Database (Railway PostgreSQL)
# DATABASE_URL will be set automatically by Railway
# No need to set DB_HOST, DB_PORT, etc. separately

# JWT Configuration (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=production
# PORT will be set automatically by Railway
# Railway provides PORT env var automatically

# CORS Configuration
# Update with your Railway app URL
CORS_ORIGIN=https://your-app-name.railway.app

# ============================================================================
# OPTIONAL VARIABLES (for features)
# ============================================================================

# OpenAI API (for Workshop Intelligence LLM Analysis)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google AI (for Gemini models)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-app.railway.app

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# Google Cloud Storage (if using GCS)
GOOGLE_APPLICATION_CREDENTIALS_JSON=your-gcp-credentials.json
GOOGLE_CLOUD_BUCKET=your-gcs-bucket

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DEPRECATED VARIABLES (Do not use - replaced with PostgreSQL)
# ==============================================================================
# The following are NO LONGER USED:
# - REDIS_HOST, REDIS_PORT, REDIS_URL (replaced with PostgreSQL)
# - BULL_QUEUE_CONFIG (replaced with PostgreSQL job queue)
# ==============================================================================